#version 450

// One thread per CullItem. Visible instances pack into a fixed per-batch region:
//   out_instances[batch.base + atomicAdd(counts[batch], 1)] = ...
// Frustum test + optional same-frame Hi-Z occlusion (depth prepass at current pose).
// When hzb_enabled, hzb_view_proj must match the prepass view_proj that built the pyramid.
layout(local_size_x = 64) in;

struct CullItem {
    mat4  model;
    vec4  aabb_min; // xyz = local AABB min
    vec4  aabb_max; // xyz = local AABB max
    uvec4 meta;     // x = material_index, y = batch_index, z = base, w = capacity
    uvec4 skin;     // x = joint_base, y = joint_count (0 = rigid)
};

struct DrawInstance {
    mat4  model;
    uvec4 meta; // x = material, y = joint_base, z = joint_count, w = reserved
};

layout(set = 0, binding = 0, std140) uniform CullGlobals {
    vec4  planes[6];
    uint  item_count;
    uint  batch_count;
    uint  hzb_enabled; // 1 = test same-frame HZB (from depth prepass)
    uint  hzb_mips;
    // View-projection that wrote the HZB depth (same as frustum camera for same-frame).
    mat4  hzb_view_proj;
    vec4  hzb_info; // xy = HZB mip0 size (pixels), z = depth bias, w = unused
} globals;

layout(set = 0, binding = 1, std430) readonly buffer CullItems {
    CullItem items[];
};

layout(set = 0, binding = 2, std430) writeonly buffer OutInstances {
    DrawInstance out_instances[];
};

layout(set = 0, binding = 3, std430) buffer BatchCounts {
    uint batch_counts[];
};

layout(set = 0, binding = 6) uniform sampler2D hzb;

// Plane: dot(n, p) + d >= 0 is inside (matches core::Frustum).
bool frustum_intersects_aabb(vec3 wmin, vec3 wmax) {
    vec3 ext = wmax - wmin;
    vec3 pad = ext * 0.05 + vec3(0.05);
    wmin -= pad;
    wmax += pad;

    for (int i = 0; i < 6; ++i) {
        vec3 n = globals.planes[i].xyz;
        float d = globals.planes[i].w;
        vec3 p = vec3(
            n.x >= 0.0 ? wmax.x : wmin.x,
            n.y >= 0.0 ? wmax.y : wmin.y,
            n.z >= 0.0 ? wmax.z : wmin.z);
        if (dot(n, p) + d < -0.02)
            return false;
    }
    return true;
}

void transform_aabb(mat4 m, vec3 bmin, vec3 bmax, out vec3 wmin, out vec3 wmax) {
    wmin = vec3( 1e30);
    wmax = vec3(-1e30);
    for (int i = 0; i < 8; ++i) {
        vec3 c = vec3(
            (i & 1) != 0 ? bmax.x : bmin.x,
            (i & 2) != 0 ? bmax.y : bmin.y,
            (i & 4) != 0 ? bmax.z : bmin.z);
        vec3 w = (m * vec4(c, 1.0)).xyz;
        wmin = min(wmin, w);
        wmax = max(wmax, w);
    }
}

// Same-frame Hi-Z (Vulkan depth 0=near, 1=far, LESS). Min pyramid stores the
// closest surface. Conservative cull: only reject if the AABB's nearest Z is
// still farther than the *farthest* of several HZB samples over its screen rect.
//
// Min pyramids *dilate* close geometry at coarse mips — that makes occluders look
// larger than they are and false-culls neighbors. Prefer finer mips, no extra
// percent padding, and bail when the footprint has mixed depths.
bool hzb_occluded(vec3 wmin, vec3 wmax) {
    if (globals.hzb_enabled == 0u)
        return false;

    float z_near = 1.0;
    vec2 uv_min = vec2( 1e30);
    vec2 uv_max = vec2(-1e30);

    // Require a fully valid projected AABB. Skipping clipped corners shrinks the
    // UV rect while keeping a close z_near → samples the wrong (often occluder)
    // footprint and false-culls.
    for (int i = 0; i < 8; ++i) {
        vec3 c = vec3(
            (i & 1) != 0 ? wmax.x : wmin.x,
            (i & 2) != 0 ? wmax.y : wmin.y,
            (i & 4) != 0 ? wmax.z : wmin.z);
        vec4 clip = globals.hzb_view_proj * vec4(c, 1.0);

        if (clip.w <= 1e-3)
            return false;

        vec3 ndc = clip.xyz / clip.w;
        // Outside clip volume in Z → do not occlude-cull (projection unreliable).
        if (ndc.z < 0.0 || ndc.z > 1.0)
            return false;
        // Outside NDC xy: still expand the rect (clamped), but only if not wildly off.
        if (abs(ndc.x) > 1.5 || abs(ndc.y) > 1.5)
            return false;

        vec2 uv = clamp(ndc.xy * 0.5 + 0.5, vec2(0.0), vec2(1.0));
        z_near = min(z_near, ndc.z);
        uv_min = min(uv_min, uv);
        uv_max = max(uv_max, uv);
    }

    if (z_near >= 0.999 || z_near < 1e-4)
        return false;

    vec2 uv_size = uv_max - uv_min;
    if (uv_size.x <= 1e-6 || uv_size.y <= 1e-6)
        return false;

    vec2 hzb_size = max(globals.hzb_info.xy, vec2(1.0));
    vec2 size_px = uv_size * hzb_size;
    float max_extent = max(size_px.x, size_px.y);

    // Mip so the larger axis spans ~4 texels (finer than "1 texel" which over-dilates).
    // Old formula used log2(extent)-1 (~2 texels) and still over-culled neighbors.
    float max_mip = float(max(globals.hzb_mips, 1u) - 1u);
    float mip_f = floor(log2(max(max_extent, 1.0)) - 2.0);
    mip_f = clamp(mip_f, 0.0, max_mip);

    // Half-texel pad *at the chosen mip only* (covers filtering/quantization).
    // Percent-of-AABB padding expands into neighboring occluders and grows them.
    vec2 texel_uv = exp2(mip_f) / hzb_size;
    uv_min = clamp(uv_min - 0.5 * texel_uv, vec2(0.0), vec2(1.0));
    uv_max = clamp(uv_max + 0.5 * texel_uv, vec2(0.0), vec2(1.0));
    if (uv_min.x >= uv_max.x || uv_min.y >= uv_max.y)
        return false;

    // 3x3 nearest samples; use MAX of mins so any "hole" (farther surface / sky)
    // prevents cull. Min-of-mins would treat a thin occluder as a solid wall.
    float farthest = 0.0;
    float closest = 1.0;
    for (int y = 0; y < 3; ++y) {
        for (int x = 0; x < 3; ++x) {
            vec2 t = vec2(float(x), float(y)) / 2.0;
            vec2 uv = mix(uv_min, uv_max, t);
            float s = textureLod(hzb, uv, mip_f).r;
            farthest = max(farthest, s);
            closest  = min(closest, s);
        }
    }

    // Any sample near clear/far → footprint not fully occluded.
    if (farthest >= 0.999)
        return false;

    // Mixed depths under the rect (edge of occluder / silhouette) → do not cull.
    // Threshold scales a little with distance (depth precision / slope).
    float depth_spread = farthest - closest;
    float spread_limit = max(0.015, z_near * 0.05);
    if (depth_spread > spread_limit)
        return false;

    // Object nearest Z must be clearly behind the least-occluding HZB sample.
    float bias = max(globals.hzb_info.z, 0.002);
    bias = max(bias, z_near * 0.01);
    return z_near > farthest + bias;
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= globals.item_count)
        return;

    CullItem item = items[id];
    uint batch = item.meta.y;
    if (batch >= globals.batch_count)
        return;

    vec3 wmin, wmax;
    transform_aabb(item.model, item.aabb_min.xyz, item.aabb_max.xyz, wmin, wmax);
    if (!frustum_intersects_aabb(wmin, wmax))
        return;
    if (hzb_occluded(wmin, wmax))
        return;

    uint base = item.meta.z;
    uint capacity = item.meta.w;
    uint slot = atomicAdd(batch_counts[batch], 1u);
    if (slot >= capacity)
        return;

    DrawInstance di;
    di.model = item.model;
    di.meta = uvec4(item.meta.x, item.skin.x, item.skin.y, 0u);
    out_instances[base + slot] = di;
}
