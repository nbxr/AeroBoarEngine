#version 450

// One thread per CullItem. Visible instances pack into a fixed per-batch region:
//   out_instances[batch.base + atomicAdd(counts[batch], 1)] = ...
// Frustum test + optional same-frame Hi-Z occlusion (depth prepass at current pose).
// When hzb_enabled, hzb_view_proj must match the prepass view_proj that built the pyramid.
layout(local_size_x = 64) in;

struct CullItem {
    vec4  aabb_min; // xyz = local AABB min
    vec4  aabb_max; // xyz = local AABB max
    uvec4 meta;     // x = material_index, y = batch_index, z = base, w = capacity
    // x=joint_base, y=joint_count, z=material flags, w=transform_index
    uvec4 skin;
};

struct DrawInstance {
    mat4  model;
    uvec4 meta; // x = material, y = joint_base, z = joint_count, w = reserved
};

layout(set = 0, binding = 0, std140) uniform CullGlobals {
    vec4  planes[6];
    uint  item_count;
    uint  batch_count;
    uint  hzb_enabled; // 1 = test same-frame HZB (from opaque depth prepass)
    uint  hzb_mips;
    mat4  hzb_view_proj;
    vec4  hzb_info; // xy = HZB mip0 size (pixels), z = depth bias
    uint  emit_filter; // 0=all, 1=opaque depth writers, 2=transparent only
    // Offset into combined out_instances (0 = opaque half, N = transparent half)
    uint  instance_base_offset;
    uint  pad1;
    uint  pad2;
} globals;

layout(set = 0, binding = 1, std430) readonly buffer CullItems {
    CullItem items[];
};

layout(set = 0, binding = 2, std430) writeonly buffer OutInstances {
    DrawInstance out_instances[];
};

layout(set = 0, binding = 3, std430) buffer BatchCounts {
    uint batch_counts[];
};

layout(set = 0, binding = 6) uniform sampler2D hzb;

layout(set = 0, binding = 7, std430) readonly buffer Worlds {
    mat4 worlds[];
};

// Must match gfx::Material flags.
const uint kFlagAlphaBlend   = 32u;   // 1 << 5
const uint kFlagTransmission = 1024u; // 1 << 10

// Plane: dot(n, p) + d >= 0 is inside (matches core::Frustum).
bool frustum_intersects_aabb(vec3 wmin, vec3 wmax) {
    vec3 ext = wmax - wmin;
    // Scale-relative pad only (no +0.05 m — that wrecks tabletop / worldScale).
    vec3 pad = max(ext * 0.01, vec3(1e-4));
    wmin -= pad;
    wmax += pad;

    for (int i = 0; i < 6; ++i) {
        vec3 n = globals.planes[i].xyz;
        float d = globals.planes[i].w;
        vec3 p = vec3(
            n.x >= 0.0 ? wmax.x : wmin.x,
            n.y >= 0.0 ? wmax.y : wmin.y,
            n.z >= 0.0 ? wmax.z : wmin.z);
        if (dot(n, p) + d < -0.02)
            return false;
    }
    return true;
}

void transform_aabb(mat4 m, vec3 bmin, vec3 bmax, out vec3 wmin, out vec3 wmax) {
    wmin = vec3( 1e30);
    wmax = vec3(-1e30);
    for (int i = 0; i < 8; ++i) {
        vec3 c = vec3(
            (i & 1) != 0 ? bmax.x : bmin.x,
            (i & 2) != 0 ? bmax.y : bmin.y,
            (i & 4) != 0 ? bmax.z : bmin.z);
        vec3 w = (m * vec4(c, 1.0)).xyz;
        wmin = min(wmin, w);
        wmax = max(wmax, w);
    }
}

// Conservative same-frame Hi-Z (reverse-Z: 1=near, 0=far). Pyramid RG: R=min, G=max.
// Closest AABB point is max(ndc.z). Farthest tile surface / hole is min (R).
// Sky / holes drop min ≈ 0 → no cull. Cull iff closest AABB is still behind
// the tile's farthest occluder (z_close < hzb.r - bias).
bool hzb_occluded(vec3 wmin, vec3 wmax) {
    if (globals.hzb_enabled == 0u)
        return false;

    float z_close = 0.0;
    vec2 uv_min = vec2( 1e30);
    vec2 uv_max = vec2(-1e30);

    for (int i = 0; i < 8; ++i) {
        vec3 c = vec3(
            (i & 1) != 0 ? wmax.x : wmin.x,
            (i & 2) != 0 ? wmax.y : wmin.y,
            (i & 4) != 0 ? wmax.z : wmin.z);
        vec4 clip = globals.hzb_view_proj * vec4(c, 1.0);
        if (clip.w <= 1e-3)
            return false;
        vec3 ndc = clip.xyz / clip.w;
        if (ndc.z < 0.0 || ndc.z > 1.0)
            return false;
        // Fully on-screen — off-screen corners would clamp UV and lie.
        if (abs(ndc.x) > 1.0 || abs(ndc.y) > 1.0)
            return false;

        vec2 uv = ndc.xy * 0.5 + 0.5;
        z_close = max(z_close, ndc.z);
        uv_min = min(uv_min, uv);
        uv_max = max(uv_max, uv);
    }

    if (z_close <= 0.001 || z_close >= 0.999)
        return false;
    if (uv_min.x >= uv_max.x || uv_min.y >= uv_max.y)
        return false;

    vec2 hzb_size = max(globals.hzb_info.xy, vec2(1.0));
    vec2 size_px = (uv_max - uv_min) * hzb_size;
    float max_extent = max(max(size_px.x, size_px.y), 1.0);
    float max_mip = float(max(globals.hzb_mips, 1u) - 1u);
    // ceil: one texel must cover the whole rect (floor + center tap is not conservative).
    float mip_f = clamp(ceil(log2(max_extent)), 0.0, max_mip);

    // R = min = farthest surface / hole. 4-corner min so an unaligned hole
    // at the edge of the rect is not missed by a center sample.
    float z_far_tile = min(
        min(textureLod(hzb, uv_min, mip_f).r,
            textureLod(hzb, vec2(uv_max.x, uv_min.y), mip_f).r),
        min(textureLod(hzb, vec2(uv_min.x, uv_max.y), mip_f).r,
            textureLod(hzb, uv_max, mip_f).r));
    if (z_far_tile <= 0.001)
        return false;

    float bias = max(globals.hzb_info.z, 1e-4);
    return z_close < z_far_tile - bias;
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= globals.item_count)
        return;

    CullItem item = items[id];
    uint batch = item.meta.y;
    if (batch >= globals.batch_count)
        return;

    // emit_filter: 1 = solid depth (opaque/MASK), 2 = transparent (blend/transmission)
    bool writes_opaque =
        (item.skin.z & (kFlagAlphaBlend | kFlagTransmission)) == 0u;
    if (globals.emit_filter == 1u && !writes_opaque)
        return;
    if (globals.emit_filter == 2u && writes_opaque)
        return;

    uint tid = item.skin.w;
    mat4 model = worlds[tid];

    vec3 wmin, wmax;
    transform_aabb(model, item.aabb_min.xyz, item.aabb_max.xyz, wmin, wmax);
    if (!frustum_intersects_aabb(wmin, wmax))
        return;
    // Hi-Z was built from opaque-only depth; still test all shade candidates.
    if (hzb_occluded(wmin, wmax))
        return;

    uint base = item.meta.z;
    uint capacity = item.meta.w;
    uint slot = atomicAdd(batch_counts[batch], 1u);
    if (slot >= capacity)
        return;

    DrawInstance di;
    di.model = model;
    di.meta = uvec4(item.meta.x, item.skin.x, item.skin.y, 0u);
    out_instances[globals.instance_base_offset + base + slot] = di;
}
