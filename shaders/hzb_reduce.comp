#version 450

// Hierarchical Z reduce: R = min of 2x2 mins, G = max of 2x2 maxes.
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D src_mip;
layout(set = 0, binding = 1, rg32f) writeonly uniform image2D dst_mip;

layout(push_constant) uniform PC {
    uvec2 src_extent;
    uvec2 dst_extent;
} pc;

void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= pc.dst_extent.x || p.y >= pc.dst_extent.y)
        return;

    vec2 inv = 1.0 / vec2(pc.src_extent);
    vec2 base = (vec2(p) * 2.0 + vec2(0.5)) * inv;

    vec2 d00 = texture(src_mip, base).rg;
    vec2 d10 = texture(src_mip, base + vec2(inv.x, 0.0)).rg;
    vec2 d01 = texture(src_mip, base + vec2(0.0, inv.y)).rg;
    vec2 d11 = texture(src_mip, base + vec2(inv.x, inv.y)).rg;

    float mn = min(min(d00.r, d10.r), min(d01.r, d11.r));
    float mx = max(max(d00.g, d10.g), max(d01.g, d11.g));
    imageStore(dst_mip, ivec2(p), vec4(mn, mx, 0.0, 0.0));
}
