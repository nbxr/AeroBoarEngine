#version 450

// Hierarchical Z reduce: R = min of 2x2 mins, G = max of 2x2 maxes.
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D src_mip;
layout(set = 0, binding = 1, rg32f) writeonly uniform image2D dst_mip;

layout(push_constant) uniform PC {
    uvec2 src_extent;
    uvec2 dst_extent;
} pc;

void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= pc.dst_extent.x || p.y >= pc.dst_extent.y)
        return;

    // Integer coverage like hzb_copy so odd source extents (15→7→3→1)
    // still fold the last row/column into min. A fixed 2×2 from even
    // origins drops that edge and makes parent R too large (false culls).
    uvec2 block = uvec2(
        (p.x * pc.src_extent.x) / pc.dst_extent.x,
        (p.y * pc.src_extent.y) / pc.dst_extent.y);
    uvec2 block_end = uvec2(
        ((p.x + 1u) * pc.src_extent.x + pc.dst_extent.x - 1u) / pc.dst_extent.x,
        ((p.y + 1u) * pc.src_extent.y + pc.dst_extent.y - 1u) / pc.dst_extent.y);
    block_end = min(block_end, pc.src_extent);
    if (block_end.x <= block.x)
        block_end.x = min(block.x + 1u, pc.src_extent.x);
    if (block_end.y <= block.y)
        block_end.y = min(block.y + 1u, pc.src_extent.y);

    float mn = 1.0;
    float mx = 0.0;
    for (uint y = block.y; y < block_end.y; ++y) {
        for (uint x = block.x; x < block_end.x; ++x) {
            vec2 d = texelFetch(src_mip, ivec2(int(x), int(y)), 0).rg;
            mn = min(mn, d.r);
            mx = max(mx, d.g);
        }
    }
    imageStore(dst_mip, ivec2(p), vec4(mn, mx, 0.0, 0.0));
}
